{
  "name": "@coloxel/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:rollback": "tsx src/db/migrate.ts down"
  },
  "dependencies": {
    "@coloxel/generator": "*",
    "@coloxel/render": "*",
    "@fastify/cookie": "^11.1.2",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.6",
    "fastify": "^5.2.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0"
  }
}

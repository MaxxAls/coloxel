# Copier en .env et remplir. Ne jamais commiter .env.
PORT=3000
DATABASE_URL=postgres://coloxel:coloxel@localhost:5432/coloxel
ANTHROPIC_API_KEY=
GENERATOR_MODEL=
SESSION_SECRET=
# Serveur temps réel (Colyseus). Sans REDIS_URL, la présence reste en mémoire (un seul processus).
REALTIME_PORT=2567
REDIS_URL=redis://localhost:6379
# Origines autorisées à ouvrir une connexion temps réel (séparées par des virgules).
CLIENT_ORIGINS=http://localhost:5173
# true derrière un reverse proxy (l'IP du client vient de X-Forwarded-For, utilisée par les limites de débit).
TRUST_PROXY=false
# true en développement local pour désactiver les limites de débit (jamais en production).
DISABLE_RATE_LIMIT=false

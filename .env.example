# Copier en .env et remplir. Ne jamais commiter .env.
PORT=3000
DATABASE_URL=postgres://coloxel:coloxel@localhost:5432/coloxel
ANTHROPIC_API_KEY=
GENERATOR_MODEL=
SESSION_SECRET=
# Serveur temps réel (Colyseus). Sans REDIS_URL, la présence reste en mémoire (un seul processus).
REALTIME_PORT=2567
REDIS_URL=redis://localhost:6379
# Origines autorisées à ouvrir une connexion temps réel (séparées par des virgules).
CLIENT_ORIGINS=http://localhost:5173
# true derrière un reverse proxy (l'IP du client vient de X-Forwarded-For, utilisée par les limites de débit).
TRUST_PROXY=false
# true en développement local pour désactiver les limites de débit (jamais en production).
DISABLE_RATE_LIMIT=false
# Lien d'invitation du Discord de la bêta (https://discord.gg/... ), affiché dans le menu du compte. Vide : pas de lien.
DISCORD_INVITE_URL=
# Marché (valeurs provisoires, voir docs/phase-3-beta-fermee.md) : commission détruite et royalties du créateur en pour cent, prix min et max, durée d'une offre en jours, offres actives par joueur.
MARKET_COMMISSION_PERCENT=5
MARKET_ROYALTY_PERCENT=5
MARKET_MIN_PRICE=1
MARKET_MAX_PRICE=100000
MARKET_LISTING_DAYS=7
MARKET_MAX_LISTINGS=20
